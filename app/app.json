{
  "expo": {
    "name": "Demet",
    "slug": "demet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "me.furkansahin.demet",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:demet.furkansahin.me"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "me.furkansahin.demet",
      "adaptiveIcon": {
        "backgroundColor": "#FBE9EE",
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundImage": "./assets/icon-background.png"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "demet.furkansahin.me",
              "pathPrefix": "/b/"
            },
            {
              "scheme": "https",
              "host": "demet.furkansahin.me",
              "pathPrefix": "/esles/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "demet",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FBFCFA",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#161F1A"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B5244D",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store"
    ],
    "description": "Sevdiğine 3D buket yap, gönder; bahçeniz birlikte büyüsün.",
    "backgroundColor": "#FBFCFA",
    "primaryColor": "#B5244D"
  }
}