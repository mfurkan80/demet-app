# Sunucuya yüklerken Dokploy'da ortam değişkeni olarak gir.
PORT=3000
DATA_DIR=/app/data
PUBLIC_URL=https://demet.ornek.com

# Yönetim paneli (/admin) şifresi. Boş bırakılırsa panel kapalı olur.
ADMIN_PASSWORD=

# Bildirim anahtarları: boş bırakırsan ilk açılışta data/vapid.json içine üretilir.
# Üretilenleri buraya kopyalarsan volume silinse bile bildirim abonelikleri bozulmaz.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sen@ornek.com

# iyzico: boşsa deneme modu (para çekilmez). Önce sandbox anahtarlarıyla dene.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# DEMO_PURCHASES=off   # iyzico yokken deneme satın alımını kapatır

# Mobil uygulama (ayrıntı: mobile/MOBILE.md)
FCM_SERVICE_ACCOUNT=
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
IOS_APP_ID=
ANDROID_PACKAGE=me.furkansahin.demet
ANDROID_SHA256=

# Gizlilik ve kullanım koşulları sayfalarındaki veri sorumlusu bilgileri
LEGAL_NAME=
LEGAL_EMAIL=
LEGAL_ADDRESS=
